diff --git a/core/umh/pipe.go b/core/umh/pipe.go
new file mode 100644
index 0000000..3f6cb60
--- /dev/null
+++ b/core/umh/pipe.go
@@ -0,0 +1,133 @@
+// UMH additions to tdl v0.20.4; licensed under the upstream AGPL-3.0.
+package umh
+
+import (
+	"bufio"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"sync"
+)
+
+type Pipe struct {
+	in        io.ReadCloser
+	reader    *bufio.Reader
+	out       io.Writer
+	mu        sync.Mutex
+	closeOnce sync.Once
+	lines     chan []byte
+	ended     chan struct{}
+}
+
+func NewPipe(in io.ReadCloser, out io.Writer) *Pipe {
+	return &Pipe{in: in, reader: bufio.NewReaderSize(in, 65537), out: out}
+}
+
+// NewWatchingPipe uses exactly one bounded reader, also observing EOF during QR waits.
+func NewWatchingPipe(in io.ReadCloser, out io.Writer) *Pipe {
+	p := NewPipe(in, out)
+	p.lines = make(chan []byte, 1)
+	p.ended = make(chan struct{})
+	go func() {
+		defer close(p.ended)
+		defer close(p.lines)
+		for {
+			line, e := p.reader.ReadSlice('\n')
+			if e != nil || len(line) > 65536 {
+				return
+			}
+			b := append([]byte(nil), line...)
+			select {
+			case p.lines <- b:
+			default:
+				return
+			}
+		}
+	}()
+	return p
+}
+func (p *Pipe) Ended() <-chan struct{} { return p.ended }
+
+// Some Windows anonymous pipes cannot interrupt a synchronous Read via Close. Never wait for that OS call; the owning process exits on cancellation.
+func (p *Pipe) Close() error { p.closeOnce.Do(func() { go p.in.Close() }); return nil }
+
+type Delivery struct {
+	Method           string `json:"method"`
+	NextMethod       string `json:"nextMethod,omitempty"`
+	TimeoutSeconds   *int   `json:"timeoutSeconds,omitempty"`
+	ResendsRemaining int    `json:"resendsRemaining"`
+}
+type Reply struct {
+	Text   string
+	Resend bool
+}
+
+func (p *Pipe) Ask(ctx context.Context, field string) (string, error) {
+	r, e := p.ask(ctx, field, nil)
+	return r.Text, e
+}
+func (p *Pipe) AskCode(ctx context.Context, d Delivery) (Reply, error) { return p.ask(ctx, "code", &d) }
+func (p *Pipe) ask(ctx context.Context, field string, delivery *Delivery) (Reply, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if ctx.Err() != nil {
+		return Reply{}, ctx.Err()
+	}
+	if field != "phone" && field != "code" && field != "password" {
+		return Reply{}, ErrInput
+	}
+	b := make([]byte, 24)
+	if _, e := rand.Read(b); e != nil {
+		return Reply{}, ErrInput
+	}
+	nonce := hex.EncodeToString(b)
+	typ := "password"
+	if field == "phone" {
+		typ = "text"
+	}
+	event := map[string]any{"version": 1, "type": "input_required", "promptId": nonce, "field": field, "inputType": typ}
+	if delivery != nil {
+		event["delivery"] = delivery
+	}
+	if e := json.NewEncoder(p.out).Encode(event); e != nil {
+		return Reply{}, ErrInput
+	}
+	type result struct {
+		s Reply
+		e error
+	}
+	done := make(chan result, 1)
+	go func() {
+		line, e := p.readLine(ctx)
+		if e != nil || len(line) > 65536 {
+			done <- result{e: ErrInput}
+			return
+		}
+		s, e := promptResponse(line, nonce, delivery != nil)
+		done <- result{s, e}
+	}()
+	select {
+	case <-ctx.Done():
+		p.Close()
+		return Reply{}, ctx.Err()
+	case v := <-done:
+		return v.s, v.e
+	}
+}
+
+func (p *Pipe) readLine(ctx context.Context) ([]byte, error) {
+	if p.lines == nil {
+		return p.reader.ReadSlice('\n')
+	}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case line, ok := <-p.lines:
+		if !ok {
+			return nil, io.EOF
+		}
+		return line, nil
+	}
+}
diff --git a/core/umh/pipe_test.go b/core/umh/pipe_test.go
new file mode 100644
index 0000000..7cfc9fd
--- /dev/null
+++ b/core/umh/pipe_test.go
@@ -0,0 +1,104 @@
+package umh
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestPipeSequence(t *testing.T) {
+	inR, inW, _ := os.Pipe()
+	outR, outW, _ := os.Pipe()
+	defer inW.Close()
+	defer outR.Close()
+	defer outW.Close()
+	p := NewPipe(inR, outW)
+	defer p.Close()
+	requests := bufio.NewReader(outR)
+	seen := map[string]bool{}
+	for _, field := range []string{"phone", "code", "password"} {
+		done := make(chan error, 1)
+		go func() {
+			s, e := p.Ask(context.Background(), field)
+			if e == nil && s != "秘密synthetic" {
+				e = io.ErrUnexpectedEOF
+			}
+			done <- e
+		}()
+		line, _ := requests.ReadBytes('\n')
+		var event map[string]any
+		json.Unmarshal(line, &event)
+		id, _ := event["promptId"].(string)
+		if len(id) < 32 || seen[id] || event["field"] != field || strings.Contains(string(line), "synthetic") {
+			t.Fatal("invalid prompt")
+		}
+		seen[id] = true
+		if field != "phone" && event["inputType"] != "password" {
+			t.Fatal("secret UI not masked")
+		}
+		b, _ := json.Marshal(map[string]string{"promptId": id, "text": "秘密synthetic"})
+		b = append(b, '\n')
+		for _, c := range b {
+			inW.Write([]byte{c})
+		}
+		if e := <-done; e != nil {
+			t.Fatal(e)
+		}
+	}
+}
+func TestPipeRejects(t *testing.T) {
+	for _, mode := range []string{"stale", "eof", "control", "oversized", "duplicate", "invalidutf8", "early", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			r, w, _ := os.Pipe()
+			or, ow, _ := os.Pipe()
+			defer w.Close()
+			defer or.Close()
+			defer ow.Close()
+			p := NewPipe(r, ow)
+			defer p.Close()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { _, e := p.Ask(ctx, "password"); done <- e }()
+			line, _ := bufio.NewReader(or).ReadBytes('\n')
+			var event map[string]any
+			json.Unmarshal(line, &event)
+			id := event["promptId"].(string)
+			switch mode {
+			case "cancel":
+				cancel()
+			case "eof":
+				w.Close()
+			case "oversized":
+				go func() { w.Write([]byte(strings.Repeat("x", 65537) + "\n")) }()
+			case "invalidutf8":
+				w.Write([]byte{255, '\n'})
+			case "duplicate":
+				w.Write([]byte(`{"promptId":"` + id + `","text":"a","text":"b"}` + "\n"))
+			default:
+				text := "synthetic-secret"
+				if mode == "stale" || mode == "early" {
+					id = "wrong"
+				}
+				if mode == "control" {
+					text = "bad\x00secret"
+				}
+				b, _ := json.Marshal(map[string]string{"promptId": id, "text": text})
+				w.Write(append(b, '\n'))
+			}
+			select {
+			case e := <-done:
+				if e == nil || strings.Contains(e.Error(), "secret") {
+					t.Fatal("unsafe error")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("did not stop")
+			}
+		})
+	}
+}
diff --git a/core/umh/strict.go b/core/umh/strict.go
new file mode 100644
index 0000000..94735aa
--- /dev/null
+++ b/core/umh/strict.go
@@ -0,0 +1,198 @@
+// UMH additions to tdl v0.20.4; licensed under the upstream AGPL-3.0.
+package umh
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+const MaxSelectedBytes = 16 << 20
+const MaxMessages = 100000
+
+var ErrInput = errors.New("invalid_input")
+
+func Kind(k string) bool { return k == "user" || k == "chat" || k == "channel" }
+func PositiveID(s string, bits int) (int64, error) {
+	if len(s) == 0 || s[0] < '1' || s[0] > '9' {
+		return 0, ErrInput
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return 0, ErrInput
+		}
+	}
+	n, e := strconv.ParseInt(s, 10, bits)
+	if e != nil {
+		return 0, ErrInput
+	}
+	return n, nil
+}
+
+// Object reads one object, rejecting duplicate keys before normal JSON decoding.
+func Object(d *json.Decoder, allowed map[string]bool) (map[string]json.RawMessage, error) {
+	tok, e := d.Token()
+	if e != nil || tok != json.Delim('{') {
+		return nil, ErrInput
+	}
+	m := map[string]json.RawMessage{}
+	for d.More() {
+		tok, e = d.Token()
+		k, ok := tok.(string)
+		if e != nil || !ok || !allowed[k] {
+			return nil, ErrInput
+		}
+		if _, exists := m[k]; exists {
+			return nil, ErrInput
+		}
+		var v json.RawMessage
+		if d.Decode(&v) != nil || !utf8.Valid(v) {
+			return nil, ErrInput
+		}
+		m[k] = v
+	}
+	tok, e = d.Token()
+	if e != nil || tok != json.Delim('}') {
+		return nil, ErrInput
+	}
+	return m, nil
+}
+func End(d *json.Decoder) bool { var x any; return d.Decode(&x) == io.EOF }
+
+type Selected struct {
+	ID       json.Number
+	PeerType string
+	Messages []int
+}
+
+func ParseSelected(ctx context.Context, r io.Reader) (Selected, error) {
+	var out Selected
+	// Bound total input even for one huge JSON token, then iterate message entries.
+	lr := &io.LimitedReader{R: r, N: MaxSelectedBytes + 1}
+	d := json.NewDecoder(lr)
+	d.UseNumber()
+	tok, e := d.Token()
+	if e != nil || tok != json.Delim('{') {
+		return out, ErrInput
+	}
+	seen := map[string]bool{}
+	ids := map[int]bool{}
+	for d.More() {
+		if ctx.Err() != nil {
+			return out, ctx.Err()
+		}
+		tok, e = d.Token()
+		k, ok := tok.(string)
+		if e != nil || !ok || seen[k] {
+			return out, ErrInput
+		}
+		seen[k] = true
+		switch k {
+		case "id":
+			tok, e = d.Token()
+			n, ok := tok.(json.Number)
+			if e != nil || !ok {
+				return out, ErrInput
+			}
+			if _, e = PositiveID(n.String(), 64); e != nil {
+				return out, e
+			}
+			out.ID = n
+		case "peer_type":
+			if d.Decode(&out.PeerType) != nil || !Kind(out.PeerType) {
+				return out, ErrInput
+			}
+		case "messages":
+			tok, e = d.Token()
+			if e != nil || tok != json.Delim('[') {
+				return out, ErrInput
+			}
+			for d.More() {
+				if ctx.Err() != nil {
+					return out, ctx.Err()
+				}
+				if len(out.Messages) >= MaxMessages {
+					return out, ErrInput
+				}
+				m, e := Object(d, map[string]bool{"id": true, "type": true, "file": true, "photo": true})
+				if e != nil {
+					return out, e
+				}
+				id, e := PositiveID(string(m["id"]), 32)
+				if e != nil || ids[int(id)] {
+					return out, ErrInput
+				}
+				var typ, file, photo string
+				if json.Unmarshal(m["type"], &typ) != nil || typ != "message" {
+					return out, ErrInput
+				}
+				if v, ok := m["file"]; ok && json.Unmarshal(v, &file) != nil {
+					return out, ErrInput
+				}
+				if v, ok := m["photo"]; ok && json.Unmarshal(v, &photo) != nil {
+					return out, ErrInput
+				}
+				if file == "" && photo == "" {
+					return out, ErrInput
+				}
+				ids[int(id)] = true
+				out.Messages = append(out.Messages, int(id))
+			}
+			tok, e = d.Token()
+			if e != nil || tok != json.Delim(']') {
+				return out, ErrInput
+			}
+		default:
+			return out, ErrInput
+		}
+	}
+	tok, e = d.Token()
+	if e != nil || tok != json.Delim('}') || !End(d) || lr.N <= 0 || !seen["messages"] || out.ID == "" || !Kind(out.PeerType) {
+		return out, ErrInput
+	}
+	return out, nil
+}
+
+func response(b []byte, nonce string) (string, error) {
+	if !utf8.Valid(b) {
+		return "", ErrInput
+	}
+	d := json.NewDecoder(strings.NewReader(string(b)))
+	m, e := Object(d, map[string]bool{"promptId": true, "text": true})
+	if e != nil || !End(d) {
+		return "", ErrInput
+	}
+	var id, s string
+	if json.Unmarshal(m["promptId"], &id) != nil || id != nonce || json.Unmarshal(m["text"], &s) != nil || s == "" || utf8.RuneCountInString(s) > 4096 {
+		return "", ErrInput
+	}
+	for _, c := range s {
+		if c < 32 || c == 127 || c == utf8.RuneError {
+			return "", ErrInput
+		}
+	}
+	return s, nil
+}
+
+func promptResponse(b []byte, nonce string, allowResend bool) (Reply, error) {
+	if allowResend && utf8.Valid(b) {
+		d := json.NewDecoder(strings.NewReader(string(b)))
+		m, e := Object(d, map[string]bool{"promptId": true, "action": true, "text": true})
+		if e != nil || !End(d) {
+			return Reply{}, ErrInput
+		}
+		if _, ok := m["action"]; ok {
+			var id, action string
+			if len(m) != 2 || json.Unmarshal(m["promptId"], &id) != nil || id != nonce || json.Unmarshal(m["action"], &action) != nil || action != "resend" {
+				return Reply{}, ErrInput
+			}
+			return Reply{Resend: true}, nil
+		}
+	}
+	text, e := response(b, nonce)
+	return Reply{Text: text}, e
+}
diff --git a/core/umh/strict_test.go b/core/umh/strict_test.go
new file mode 100644
index 0000000..aaf91c3
--- /dev/null
+++ b/core/umh/strict_test.go
@@ -0,0 +1,48 @@
+package umh
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestSelectedLossless(t *testing.T) {
+	for _, id := range []string{"9007199254740993", "9223372036854775807"} {
+		v, e := ParseSelected(context.Background(), strings.NewReader(`{"messages":[{"id":2147483647,"type":"message","file":"x"}],"id":`+id+`,"peer_type":"channel"}`))
+		if e != nil || v.ID.String() != id || len(v.Messages) != 1 || v.Messages[0] != 2147483647 {
+			t.Fatalf("lossless failed: %v", e)
+		}
+	}
+}
+func TestSelectedRejects(t *testing.T) {
+	for _, src := range []string{
+		`{"id":1,"messages":[]}`, `{"id":1,"peer_type":"wat","messages":[]}`,
+		`{"id":1,"id":2,"peer_type":"user","messages":[]}`,
+		`{"id":1e2,"peer_type":"user","messages":[]}`,
+		`{"id":1.0,"peer_type":"user","messages":[]}`,
+		`{"id":-1,"peer_type":"user","messages":[]}`,
+		`{"id":"1","peer_type":"user","messages":[]}`,
+		`{"id":9223372036854775808,"peer_type":"user","messages":[]}`,
+		`{"id":1,"peer_type":"user","messages":[{"id":0,"type":"message","file":"x"}]}`,
+		`{"id":1,"peer_type":"user","messages":[{"id":2147483648,"type":"message","file":"x"}]}`,
+		`{"id":1,"peer_type":"user","messages":[{"id":1,"id":2,"type":"message","file":"x"}]}`,
+		`{"id":1,"peer_type":"user","messages":[{"id":1,"type":"service","file":"x"}]}`,
+		`{"id":1,"peer_type":"user","messages":[{"id":1,"type":"message","file":"x"},{"id":1,"type":"message","file":"x"}]}`,
+		`{"id":1,"peer_type":"user","messages":[]`,
+		`{"id":1,"peer_type":"user","messages":[]} {}`,
+	} {
+		if _, e := ParseSelected(context.Background(), strings.NewReader(src)); e == nil {
+			t.Errorf("accepted malformed fixture %s", src)
+		}
+	}
+}
+func TestSelectedBoundedCanceled(t *testing.T) {
+	if _, e := ParseSelected(context.Background(), strings.NewReader(strings.Repeat(" ", MaxSelectedBytes+1))); e == nil {
+		t.Fatal("unbounded")
+	}
+	c, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, e := ParseSelected(c, strings.NewReader(`{"id":1,"peer_type":"user","messages":[]}`)); e == nil {
+		t.Fatal("ignored cancel")
+	}
+}
