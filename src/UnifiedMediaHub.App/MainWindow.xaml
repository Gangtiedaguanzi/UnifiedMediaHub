<Window x:Class="UnifiedMediaHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="统一媒体管理器" Width="1200" Height="800" MinWidth="1000" MinHeight="700" Background="{DynamicResource Canvas}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="{DynamicResource Ink}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" Color="#F4F6F9"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#1E293B"/>
  <SolidColorBrush x:Key="Muted" Color="#64748B"/>
  <SolidColorBrush x:Key="Faint" Color="#94A3B8"/>
  <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="LineStrong" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="Accent" Color="#0D7C72"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#E6F4F1"/>
  <SolidColorBrush x:Key="Warn" Color="#B45309"/>

  <!-- Buttons: one rounded template; hover/press darken with an overlay so every colour variant works. -->
  <Style TargetType="Button">
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,0"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="root">
     <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
     <Border x:Name="o" Background="#0F172A" Opacity="0" CornerRadius="7"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="o" Property="Opacity" Value="0.05"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="o" Property="Opacity" Value="0.11"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,0"/>
  </Style>
  <Style x:Key="Soft" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="BorderBrush" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="18,0"/>
  </Style>
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="10,0"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource LineStrong}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.6"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#F1F5F9"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="110"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="11,0,30,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid x:Name="root">
     <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="b" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7">
        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L4.5,4.5 L9,0" Stroke="#64748B" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#CBD5E1"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#0D7C72"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <DockPanel Background="Transparent">
     <Border x:Name="box" DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="#94A3B8" Background="White" VerticalAlignment="Center">
      <Path x:Name="mark" Data="M3,7.6 L6.2,10.8 L12,4.6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter x:Name="content" Margin="9,0,0,0" VerticalAlignment="Center"/>
    </DockPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="HasContent" Value="False"><Setter TargetName="content" Property="Margin" Value="0"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#0D7C72"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="#0D7C72"/><Setter TargetName="box" Property="BorderBrush" Value="#0D7C72"/><Setter TargetName="mark" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Navigation: text tabs with an accent underline; the strip leaves room for the app title on its left. -->
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" Margin="236,0,0,-1"/></Border>
     <!-- The part name lets UI Automation (screen readers, tests) reach the page content. -->
     <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,18,0,0"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Grid Background="Transparent" Cursor="Hand" Margin="0,0,30,0">
     <ContentPresenter x:Name="c" ContentSource="Header" Margin="2,14,2,15" TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="14.5"/>
     <Border x:Name="bar" Height="3" VerticalAlignment="Bottom" CornerRadius="1.5" Background="Transparent"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="c" Property="TextElement.Foreground" Value="{StaticResource Ink}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="c" Property="TextElement.Foreground" Value="{StaticResource Ink}"/><Setter TargetName="c" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="bar" Property="Background" Value="{StaticResource Accent}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="ThinThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="t" CornerRadius="3" Background="#CBD5E1"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#94A3B8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThinThumb}" Margin="2"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
    <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="False"><Track.Thumb><Thumb Style="{StaticResource ThinThumb}" Margin="2"/></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter>
   </Trigger></Style.Triggers>
  </Style>

  <Style TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="RowBackground" Value="Transparent"/>
   <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
   <Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,0"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGridRow">
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F8FAFC"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EEF7F5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ReadableCell" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="MutedCell" TargetType="TextBlock" BasedOn="{StaticResource ReadableCell}"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>

  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,10,0"/></Style>
 </Window.Resources>

 <Grid Margin="26,10,26,16">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="Pages" Background="Transparent">
   <TabItem Header="下载">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="18,16">
      <StackPanel>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SourceUrl" MinHeight="38" MaxLength="16384"/>
        <TextBlock Text="粘贴作品、作者主页或 Telegram 消息链接" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SourceUrl}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Button Grid.Column="1" Content="粘贴" Click="Paste_Click" Margin="8,0" MinHeight="38"/>
        <Button x:Name="ScanButton" Grid.Column="2" Content="识别并扫描" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0" MinHeight="38"/>
       </Grid>
       <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="从账号读取" Style="{StaticResource FieldLabel}"/>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
         <ComboBox x:Name="SourcePlatform" SelectedIndex="1" SelectionChanged="SourcePlatform_Changed"><ComboBoxItem Content="X" Tag="x"/><ComboBoxItem Content="抖音" Tag="douyin"/><ComboBoxItem Content="小红书" Tag="xiaohongshu"/></ComboBox>
         <ComboBox x:Name="OwnKind" SelectedIndex="0" MinWidth="130"><ComboBoxItem Content="全部收藏" Tag="saved"/><ComboBoxItem Content="我的喜欢" Tag="liked"/><ComboBoxItem x:Name="BridgeProfileOption" Content="作者作品（Edge）" Tag="profile"/></ComboBox>
         <Button Content="扫描上述来源" Click="OwnSource_Click"/>
         <Button x:Name="FoldersButton" Content="选择收藏夹" Click="Folders_Click"/>
         <Button Content="Telegram 聊天" Click="Chats_Click"/>
        </WrapPanel>
        <StackPanel x:Name="BridgeHint" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="抖音列表从 Edge 发送" Style="{StaticResource FieldLabel}" Margin="0,0,2,0"/>
         <Button Content="桥接设置" Click="BridgeSettings_Click" Style="{StaticResource Ghost}" Margin="0"/>
        </StackPanel>
       </Grid>
       <Expander x:Name="LegacyDouyinPanel" Visibility="Collapsed"><Button Content="旧方式扫描" Click="LegacyDouyin_Click" HorizontalAlignment="Left"/></Expander>
       <StackPanel x:Name="ChatChooser" Visibility="Collapsed" Margin="0,14,0,0">
        <WrapPanel>
         <TextBox x:Name="ChatSearch" Width="180" Margin="0,0,8,0" TextChanged="ChatSearch_Changed" ToolTip="按名称搜索聊天"/>
         <ComboBox x:Name="Chats" Width="300" DisplayMemberPath="Title" SelectionChanged="Chat_Changed" VirtualizingPanel.IsVirtualizing="True"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox>
         <ComboBox x:Name="Topics" Visibility="Collapsed" Width="180" DisplayMemberPath="Title"/>
         <Button x:Name="ChatScanButton" Content="扫描所选聊天" Click="ChatScan_Click" IsEnabled="False" Style="{StaticResource Soft}"/>
        </WrapPanel>
        <TextBlock x:Name="ChatDirectorySummary" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel x:Name="FolderChooser" Visibility="Collapsed" Margin="0,14,0,0">
        <WrapPanel>
         <ComboBox x:Name="Folders" Width="300" DisplayMemberPath="Display" SelectionChanged="Folder_Changed"/>
         <TextBlock Text="最多" Style="{StaticResource FieldLabel}" Margin="4,0,8,0"/><TextBox x:Name="FolderScanLimit" Text="50" Width="60" Margin="0,0,6,0"/><TextBlock Text="条" Style="{StaticResource FieldLabel}" Margin="0,0,12,0"/>
         <Button x:Name="FolderScanButton" Content="扫描所选收藏夹" Click="FolderScan_Click" IsEnabled="False" Style="{StaticResource Soft}"/>
        </WrapPanel>
        <TextBlock x:Name="FolderSummary" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>

     <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Margin="20,16,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
         <TextBlock x:Name="SourceLabel" Text="还没有选择来源" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="ScanSummary" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
         <TextBlock x:Name="ScanCheckpointLine" Visibility="Collapsed"/>
         <TextBlock x:Name="ScanDurableLine" Visibility="Collapsed"/>
         <WrapPanel x:Name="BridgeReviewPanel" Visibility="Collapsed" Margin="0,8,0,0"><TextBlock Text="这批内容来自另一个抖音账号，确认后才能下载。" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="BridgeConfirmButton" Content="确认并允许下载" Click="BridgeConfirm_Click" Style="{StaticResource Soft}"/></WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <Button x:Name="SelectAllButton" Content="全选" Click="SelectAll_Click" Style="{StaticResource Ghost}"/>
         <Button x:Name="SelectNoneButton" Content="全不选" Click="SelectNone_Click" Style="{StaticResource Ghost}"/>
         <Button x:Name="AuthorButton" Content="查看该作者作品" Click="Author_Click" IsEnabled="False" Style="{StaticResource Ghost}" Margin="0"/>
        </StackPanel>
       </Grid>
       <Grid Grid.Row="1" Margin="8,0,8,0">
        <DataGrid x:Name="PreviewGrid" SelectionMode="Single" ItemsSource="{Binding Rows}" MinRowHeight="86" LoadingRow="Preview_LoadingRow" UnloadingRow="Preview_UnloadingRow" SelectionChanged="Preview_SelectionChanged" IsReadOnly="False">
         <DataGrid.ContextMenu><ContextMenu><MenuItem Header="查看文件结果" Click="ItemResults_Click"/><MenuItem Header="打开所在文件夹" Click="ItemFolder_Click"/><MenuItem Header="打开原始链接" Click="OriginalLink_Click" IsEnabled="{Binding PlacementTarget.SelectedItem.HasPublicLink, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="50"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="预览" Width="124"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Margin="6,8" Height="68" CornerRadius="6" Background="#EEF2F6"><Grid><TextBlock Text="无预览" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Faint}" FontSize="11"/><Image Source="{Binding Image}" Stretch="Uniform" MaxWidth="108" MaxHeight="68"/></Grid></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="内容" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Attribution}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="媒体" Binding="{Binding MediaCount}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"/>
          <DataGridTextColumn Header="状态" Binding="{Binding Result}" Width="170" IsReadOnly="True" ElementStyle="{StaticResource ReadableCell}"/>
         </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
         <TextBlock Text="还没有内容" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
         <TextBlock Text="粘贴链接，或从账号读取后点扫描" Foreground="{StaticResource Faint}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
       </Grid>
       <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,12,16,12">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="SelectionSummary" Text="已选择 0 项" FontWeight="SemiBold"/>
          <TextBlock x:Name="DestinationLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,12,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="暂停" Click="Pause_Click"/>
          <Button Content="打开文件夹" Click="OpenFolder_Click"/>
          <Button x:Name="DownloadButton" Content="下载所选" Style="{StaticResource Primary}" Click="Download_Click" Margin="0" MinHeight="38"/>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>
     </Border>
    </Grid>
   </TabItem>

   <TabItem Header="账号">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Border Style="{StaticResource Card}" VerticalAlignment="Top">
      <StackPanel>
       <TextBlock Text="登录账号" Style="{StaticResource CardTitle}"/>
       <WrapPanel>
        <ComboBox x:Name="LoginPlatform" SelectedIndex="0" SelectionChanged="LoginPlatform_Changed"><ComboBoxItem Content="X" Tag="x"/><ComboBoxItem Content="Telegram" Tag="telegram"/><ComboBoxItem Content="抖音" Tag="douyin"/><ComboBoxItem Content="小红书" Tag="xiaohongshu"/></ComboBox>
        <Button x:Name="LoginButton" Content="打开专用登录" Style="{StaticResource Primary}" Click="Login_Click" IsEnabled="False"/>
        <Button x:Name="LoginQrButton" Content="扫码登录" Click="LoginQr_Click" Visibility="Collapsed" IsEnabled="False" Style="{StaticResource Soft}"/>
        <Button x:Name="FinishLoginButton" Content="我已完成登录" Click="FinishLogin_Click" IsEnabled="False"/>
        <Button x:Name="StopPlatformButton" Content="停止该平台" Click="StopPlatform_Click" Style="{StaticResource Ghost}"/>
       </WrapPanel>
       <TextBlock x:Name="LoginMethodHint" Text="可以用手机号登录，也可以直接扫码登录。" Style="{StaticResource MutedText}" Margin="0,12,0,0" Visibility="Collapsed"/>
       <TextBlock x:Name="LoginAvailabilityHint" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
       <TextBlock x:Name="AccountBadge" Text="尚无已确认账号" Margin="0,16,0,14" TextWrapping="Wrap" FontWeight="SemiBold"/>
       <Border Background="#F6FAF9" BorderBrush="#DCEDEA" BorderThickness="1" Padding="18" CornerRadius="8">
        <StackPanel>
         <TextBlock x:Name="ActionMessage" Text="开启总开关后，选择平台开始登录。" TextWrapping="Wrap"/>
         <Grid x:Name="LoginQrPanel" Visibility="Collapsed" Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" Padding="10" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1"><Image x:Name="LoginQrImage" Width="230" Height="230" Stretch="Uniform"/></Border>
          <StackPanel Grid.Column="1" Margin="22,6,0,0">
           <TextBlock Text="用手机 Telegram 扫码" FontSize="16" FontWeight="SemiBold"/>
           <TextBlock Text="设置 → 设备 → 连接桌面设备，扫描左侧二维码并在手机上确认。" Style="{StaticResource MutedText}" Margin="0,10,0,12"/>
           <TextBlock x:Name="LoginQrCountdown" TextWrapping="Wrap" Foreground="{StaticResource Warn}"/>
          </StackPanel>
         </Grid>
         <StackPanel x:Name="InputPanel" Visibility="Collapsed" Margin="0,14,0,0" MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock x:Name="InputLabel" Margin="0,0,0,8" FontWeight="SemiBold"/>
          <TextBox x:Name="PhoneInput" MaxLength="4096"/>
          <PasswordBox x:Name="SecretInput" MaxLength="4096"/>
          <WrapPanel Margin="0,10,0,0">
           <Button x:Name="SubmitInputButton" Content="提交" Click="SubmitInput_Click" Style="{StaticResource Primary}"/>
           <Button x:Name="ResendCodeButton" Content="重新发送验证码" Click="ResendCode_Click" IsEnabled="False" Visibility="Collapsed"/>
          </WrapPanel>
         </StackPanel>
         <Button x:Name="ContinueButton" Content="已处理，继续" Click="Continue_Click" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </Border>
    </ScrollViewer>
   </TabItem>

   <TabItem Header="历史">
    <Border Style="{StaticResource Card}" Padding="0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel Margin="20,14,16,10">
       <Button Content="打开清单" Click="OpenHistory_Click" Style="{StaticResource Soft}"/>
       <Button x:Name="RescanButton" Content="重新扫描" Click="Rescan_Click"/>
       <Button Content="停止任务" Click="StopHistory_Click"/>
      </WrapPanel>
      <DataGrid x:Name="HistoryGrid" Grid.Row="1" Margin="8,0,8,8" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="History_DoubleClick" MinRowHeight="62">
       <DataGrid.Columns>
        <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="80" ElementStyle="{StaticResource ReadableCell}"/>
        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="*" MinWidth="180" ElementStyle="{StaticResource ReadableCell}"/>
        <DataGridTextColumn Header="时间" Binding="{Binding Created}" Width="110" ElementStyle="{StaticResource MutedCell}"/>
        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource ReadableCell}"/>
        <DataGridTextColumn Header="结果" Binding="{Binding Detail}" Width="1.6*" MinWidth="260" ElementStyle="{StaticResource MutedCell}"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </TabItem>

   <TabItem Header="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,12,0">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="下载设置" Style="{StaticResource CardTitle}"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="下载位置" Style="{StaticResource FieldLabel}"/>
         <TextBox x:Name="OutputFolder" Grid.Column="1"/>
         <Button Grid.Column="2" Content="选择…" Click="PickFolder_Click" Margin="8,0,0,0"/>
        </Grid>
        <Grid Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="分类" Style="{StaticResource FieldLabel}"/>
         <TextBox x:Name="CategoryInput" Grid.Column="1" Width="240" HorizontalAlignment="Left" ToolTip="可留空；填写后新任务会放进这个子文件夹"/>
        </Grid>
        <Grid Margin="0,12,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="扫描上限" Style="{StaticResource FieldLabel}"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="ScanLimit" Width="100" Text="0"/><TextBlock Text="0 = 不限" Style="{StaticResource FieldLabel}" Margin="10,0,0,0"/></StackPanel>
        </Grid>
        <CheckBox x:Name="FolderPerTaskBox" IsChecked="True" Margin="90,16,0,0" Content="每次下载单独一个文件夹，文件平铺在里面"/>
        <Button x:Name="SaveSettingsButton" Content="保存设置" Click="SaveSettings_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="90,18,0,0"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
       <StackPanel x:Name="EdgeBridgeSettings">
        <TextBlock Text="抖音 Edge 桥接" Style="{StaticResource CardTitle}"/>
        <WrapPanel>
         <CheckBox x:Name="BridgeEnabledBox" Content="启用" Checked="BridgeEnabled_Changed" Unchecked="BridgeEnabled_Changed" VerticalAlignment="Center" Margin="0,0,24,0"/>
         <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BridgePort" Text="47631" Width="90" MaxLength="5" Margin="0,0,8,0"/><Button Content="应用" Click="BridgeApply_Click"/>
        </WrapPanel>
        <TextBlock x:Name="BridgeStatus" Text="桥接已关闭。" Style="{StaticResource MutedText}" Margin="0,10,0,12"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="配对令牌" Style="{StaticResource FieldLabel}"/>
         <TextBox x:Name="BridgeToken" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"/>
         <Button x:Name="BridgeShowButton" Grid.Column="2" Content="显示" Click="BridgeShow_Click"/>
         <Button Grid.Column="3" Content="复制" Click="BridgeCopy_Click"/>
         <Button Grid.Column="4" Content="重新生成" Click="BridgeRegenerate_Click" Margin="0"/>
        </Grid>
        <WrapPanel Margin="0,12,0,0"><Button Content="安装说明" Click="BridgeInstructions_Click" Style="{StaticResource Soft}"/><Button x:Name="BridgeNextStep" Content="下一步" Click="BridgeNext_Click" Visibility="Collapsed"/></WrapPanel>
        <TextBlock x:Name="BridgeInstallStep" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="维护" Style="{StaticResource CardTitle}"/>
        <WrapPanel>
         <Button Content="清理缩略图缓存" Click="ClearCache_Click"/>
         <Button Content="测量浏览器数据" Click="MeasureBrowser_Click"/>
         <Button Content="导出诊断报告" Click="Export_Click"/>
        </WrapPanel>
        <TextBlock x:Name="CacheSize" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"/>
        <TextBlock x:Name="BrowserSize" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
        <TextBlock x:Name="DataLocation" Style="{StaticResource MutedText}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,14,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>

  <!-- App title and master switch sit on the tab strip row. -->
  <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Height="50" IsHitTestVisible="False">
   <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}" VerticalAlignment="Center"><TextBlock Text="媒" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="统一媒体管理器" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
   <TextBlock x:Name="FixtureLabel" Visibility="Collapsed"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Height="50">
   <TextBlock x:Name="OwnedCount" Visibility="Collapsed"/>
   <Button x:Name="MasterButton" Content="总开关：关 · 点击开启" Click="Master_Click" Style="{StaticResource Primary}" Margin="0" VerticalAlignment="Center" MinWidth="150"/>
  </StackPanel>

  <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,9" CornerRadius="8" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
   <StackPanel>
    <TextBlock x:Name="StatusLine" Text="总开关已关闭。点右上角开启后才能登录、扫描和下载。" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    <TextBlock x:Name="ResourceLine" Visibility="Collapsed"/>
    <TextBlock x:Name="HostResourceLine" Visibility="Collapsed"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
